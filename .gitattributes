# Automatically normalize text files
* text=auto

# Use Linux line endings for source and configuration files
*.py text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.env text eol=lf
*.example text eol=lf

# Keep Windows scripts using Windows line endings
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
